# =============================================================================
# Media Downloader — environment configuration
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# --- Telegram -----------------------------------------------------------
BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to use admin commands.
ADMIN_USER_IDS=

# --- Redis (internal docker network only — never expose publicly) -------
REDIS_URL=redis://redis:6379/0

# --- Language -------------------------------------------------------------
# uz (default) or en
DEFAULT_LANGUAGE=uz

# --- Concurrency & limits ---------------------------------------------
# Tuned for this project's actual server (audited: 2 vCPU, 3.7GB RAM
# [~2GB available], ~15GB free disk). Re-tune if the server is resized —
# see docs/ARCHITECTURE_AUDIT.md.
MAX_CONCURRENT_DOWNLOADS=1
MAX_USER_CONCURRENT_JOBS=1
MAX_ACTIVE_JOBS_PER_USER=1
MAX_DAILY_JOBS_PER_USER=50
MAX_QUEUE_SIZE=100

MAX_FILE_SIZE_MB=200
# Reject new jobs if free disk space on TEMP_DIR's filesystem drops below this.
MIN_FREE_DISK_MB=2048
# Hard ceiling on total bytes media-downloader may hold in TEMP_DIR at once.
MAX_TEMP_STORAGE_MB=1024

DOWNLOAD_TIMEOUT_SECONDS=180
PROCESSING_TIMEOUT_SECONDS=60
UPLOAD_TIMEOUT_SECONDS=120
JOB_TIMEOUT_SECONDS=300

# Job lease/heartbeat: if a worker holds a job "downloading" longer than this
# without renewing its lease, the job is considered stale and recovered.
JOB_LEASE_SECONDS=120
ORPHAN_CLEANUP_INTERVAL_SECONDS=300
ORPHAN_MAX_AGE_SECONDS=1800

# --- Rate limiting (Redis-backed, per Telegram user) ---------------------
MAX_REQUESTS_PER_MINUTE=10

# --- Storage --------------------------------------------------------------
TEMP_DIR=/tmp/media-downloader

# --- Quality ---------------------------------------------------------------
# One of: LOW, MEDIUM, HIGH, BEST_COMPATIBLE
DEFAULT_QUALITY=BEST_COMPATIBLE
# Local ffmpeg fallbacks tried before failing outright: fixing a video
# codec Telegram won't autoplay inline (VP9/AV1-in-mp4, sometimes served
# by Instagram/TikTok), and fitting an oversized video under the limit.
ENABLE_COMPRESSION_FALLBACK=true
# Force outbound requests over IPv4. Only useful if you're hitting
# connection issues that look like a flaky IPv6 route to a platform's CDN.
FORCE_IPV4=false

# --- Optional platform authentication ---------------------------------
# Instagram (and occasionally other platforms) increasingly reject
# anonymous requests. If that happens, put a Netscape-format cookies.txt
# from a real account you control at secrets/cookies.txt and uncomment
# the line below. Leave unset if you haven't hit this — nothing requires
# it. See README.md "Instagram cookies (optional)".
# COOKIES_FILE=/app/secrets/cookies.txt

# --- Song identification (optional) ------------------------------------
# Free API token from https://dashboard.audd.io/ — enables an
# "identify song" button under downloaded videos. Leave unset to disable
# the feature entirely (default) — nothing else requires it.
# AUDD_API_TOKEN=

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO

# --- Testing ------------------------------------------------------------
# When true, tests that hit live Instagram/TikTok/YouTube/Pinterest are enabled.
# Leave false for CI / normal development.
RUN_EXTERNAL_TESTS=false
